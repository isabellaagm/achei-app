# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# modelos de IA (gerados automaticamente pelo postinstall a partir de
# node_modules/@vladmandic/human/models — não precisam ir pro git)
/public/models/*.bin
/public/models/*.json

# typescript
*.tsbuildinfo
next-env.d.ts
